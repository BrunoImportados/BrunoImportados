# ═══════════════════════════════════════════
# VIALLUX — Configuração de APIs
# Copiar para .env e preencher com as chaves
# ═══════════════════════════════════════════

# ── APIFY (captação de leads) ─────────────
# Criar conta: https://apify.com
# Chave em: https://console.apify.com/account/integrations
APIFY_API_KEY=apify_api_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── BREVO (envio de emails) ───────────────
# Criar conta: https://app.brevo.com
# Chave em: Configurações > Chaves API > Criar chave
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BREVO_SENDER_NAME=VIALLUX Instalações Elétricas
BREVO_SENDER_EMAIL=geral@viallux.pt

# ── HUNTER.IO (emails opcionais) ──────────
# Criar conta: https://hunter.io
# Gratuito até 25 pesquisas/mês
HUNTER_API_KEY=

# ── GOOGLE SHEETS (exportação opcional) ───
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=./config/google-service-account.json

# ── WHATSAPP via TWILIO (opcional) ────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── DASHBOARD ─────────────────────────────
DASHBOARD_PORT=3000

# ── GERAL ─────────────────────────────────
NODE_ENV=production
